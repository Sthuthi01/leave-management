# Production configuration template. Copy to `.env` next to docker-compose.prod.yml and fill in
# real values — see DEPLOYMENT.md for the full deployment guide. Never commit the filled-in
# `.env` file; it holds real secrets. This is a separate file from .env.example (which is for
# local development with docker-compose.yml and Mailpit) so the two environments can't be
# accidentally mixed up.
#
# docker-compose.prod.yml fails fast with a clear error at startup if any variable marked
# "required" below is missing — there are no insecure defaults in production.

# ---- Core ----

# Required. HMAC-signs the session cookie (src/lib/session.ts). A weak or missing secret lets
# session cookies be forged. Generate one with:
#   openssl rand -hex 32
SESSION_SECRET=

# Required. Your real public URL, no trailing slash. Invitation and password-reset emails link
# back to this — if it's wrong, those links are broken for real users.
APP_URL=https://your-domain.example

# Required. The bare domain (no https://, no trailing slash) that the caddy service in
# docker-compose.prod.yml gets its HTTPS certificate for — see the Caddyfile and DEPLOYMENT.md's
# "TLS / reverse proxy" section. Must be the same domain as APP_URL above, just without the
# scheme, e.g. APP_URL=https://leave.yourcompany.com -> APP_DOMAIN=leave.yourcompany.com.
APP_DOMAIN=your-domain.example

# ---- Database ----

# Required. Postgres connection string.
#
# If you're using the bundled `db` service in docker-compose.prod.yml (a self-managed Postgres
# container — fine for a single-VM deployment), point this at it and set POSTGRES_PASSWORD
# below to the same password:
#   DATABASE_URL=postgres://leaflow:<same-password-as-POSTGRES_PASSWORD>@db:5432/leaflow
#
# If you're using a managed database instead (RDS, Cloud SQL, Neon, Supabase, etc.), delete the
# `db` service from docker-compose.prod.yml and set this to that provider's connection string
# instead. Migrations run automatically on startup either way (src/lib/db/client.ts).
DATABASE_URL=

# Required only if you keep the bundled `db` service in docker-compose.prod.yml. Must match the
# password used in DATABASE_URL above. Not used at all if you deleted that service.
POSTGRES_PASSWORD=

# ---- Backups ----

# Optional, defaults to 30. How many days of automated database backups to keep before older
# ones are deleted — see DEPLOYMENT.md's "Backups and disaster recovery" section. Only applies
# if you kept the bundled `db` service.
BACKUP_RETENTION_DAYS=30

# ---- Email (invitation / password-reset) ----

# SMTP settings used to send invitation and password-reset emails (src/lib/email.ts) — the same
# code path as local development, just pointed at a real provider instead of Mailpit. Unlike
# local dev, docker-compose.prod.yml does not default SMTP_HOST to anything, so if you leave it
# unset, emails are printed to the container's own logs instead of delivered — fine for a first
# smoke-test deploy, but not something to rely on for real users.
#
# Example values for common providers (get real credentials from the provider's dashboard):
#   SendGrid:  SMTP_HOST=smtp.sendgrid.net       SMTP_PORT=587  SMTP_USER=apikey
#   AWS SES:   SMTP_HOST=email-smtp.<region>.amazonaws.com   SMTP_PORT=587
#   Postmark:  SMTP_HOST=smtp.postmarkapp.com    SMTP_PORT=587
#   Mailgun:   SMTP_HOST=smtp.mailgun.org        SMTP_PORT=587
SMTP_HOST=
SMTP_PORT=587
# true for port 465 (implicit TLS), false for 587/25 (STARTTLS, negotiated automatically).
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Required. Must be a sender address your provider is authorized to send as (usually a verified
# domain/sender in that provider's dashboard) — unverified senders are typically rejected or
# land in spam.
EMAIL_FROM=Agrileaf <no-reply@your-domain.example>

# ---- Error tracking (optional, but strongly recommended) ----

# Sends backend errors to Sentry so you find out about a bug before your customers have to tell
# you. See DEPLOYMENT.md's "Error tracking and uptime monitoring" section for how to get this
# value (it's free to start). If left blank, the app runs exactly the same — errors just aren't
# reported anywhere external, only to this container's own logs.
SENTRY_DSN=
