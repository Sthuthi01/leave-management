# UAT configuration template for the Django + React stack. Copy to `.env.backend` next to
# docker-compose.backend.prod.yml and fill in real values — see DEPLOYMENT.md for the full guide.
# Never commit the filled-in file; it holds real secrets.
#
#   cp .env.backend.uat.example .env.backend
#   docker compose -f docker-compose.backend.prod.yml --env-file .env.backend up -d --build
#
# docker-compose.backend.prod.yml fails fast with a clear error at startup if any variable marked
# "Required" below is missing — there are no insecure defaults in this profile. DJANGO_DEBUG is
# hardcoded to false in that file and cannot be overridden here.

# ---- Core ----

# Required. Generate one with: openssl rand -hex 32
# A weak or missing secret lets session cookies be forged. Use a DIFFERENT value from production.
DJANGO_SECRET_KEY=

# Required. The UAT domain, no scheme, no trailing slash — e.g. uat-leave.yourcompany.com.
# Caddy (see Caddyfile.backend) uses this to request a real Let's Encrypt certificate, and Django
# uses it for ALLOWED_HOSTS.
BACKEND_APP_DOMAIN=uat-leave.your-domain.example

# Required. Must be https://<BACKEND_APP_DOMAIN> above — the React app's own public URL. Used for
# CORS/CSRF trusted-origin checks and to build links inside invitation/reset emails.
FRONTEND_URL=https://uat-leave.your-domain.example

# ---- Database ----

# Required. Credentials for the bundled `backend-db` service (isolated Postgres, not shared with
# the Next.js app's own database or with local dev's backend-db). No host port is exposed for it
# — see docker-compose.backend.prod.yml.
BACKEND_POSTGRES_USER=leaveapp_uat
BACKEND_POSTGRES_PASSWORD=
BACKEND_POSTGRES_DB=leaveapp_uat

# ---- First-admin bootstrap ----

# Leave unset/false for normal operation. Set to true only as a one-time `-e` override on the
# single `bootstrap_admin` command invocation — see DEPLOYMENT.md's "First HR Admin" section.
# Do NOT set it here as a standing value.
ALLOW_BOOTSTRAP_ADMIN=false

# ---- Rate limiting (accounts/throttles.py) ----
# Optional — defaults shown. UAT typically doesn't need tighter limits than production.
LOGIN_RATE_LIMIT=10/min
SET_PASSWORD_RATE_LIMIT=10/min

# ---- Frontend build ----
# Optional, defaults to same-origin "/api" (nginx proxies it to the backend container — see
# frontend/nginx.conf). Only change this if the frontend and API are deliberately split across
# two different public origins, which also requires updating CORS/CSRF above to match.
VITE_API_BASE_URL=/api

# ---- App server ----
# Optional, defaults to 1. Gunicorn worker processes. Do NOT raise this without first pointing
# Django's CACHES at a shared backend (Redis/Memcached) — the login/set-password rate limits use
# Django's default in-process cache, which is per-worker, not shared; with more than 1 worker the
# effective rate limit becomes closer to (configured rate * workers) than the configured value —
# verified live during UAT readiness testing. See DEPLOYMENT.md.
GUNICORN_WORKERS=1

# ---- Email (invitation / password-reset) ----

# SMTP settings used to send invitation and password-reset emails. If left unset, emails are
# logged to the backend container's own logs instead of delivered — acceptable for an initial UAT
# smoke test, not for real UAT users who need to actually receive their invite.
#
# Example values for common providers (get real credentials from the provider's dashboard):
#   SendGrid:  SMTP_HOST=smtp.sendgrid.net       SMTP_PORT=587  SMTP_USER=apikey
#   AWS SES:   SMTP_HOST=email-smtp.<region>.amazonaws.com   SMTP_PORT=587
#   Postmark:  SMTP_HOST=smtp.postmarkapp.com    SMTP_PORT=587
#   Mailgun:   SMTP_HOST=smtp.mailgun.org        SMTP_PORT=587
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Required. Must be a sender address your provider is authorized to send as.
EMAIL_FROM=Agrileaf <no-reply@your-domain.example>
