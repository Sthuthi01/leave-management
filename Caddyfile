# Production TLS termination and reverse proxy in front of `app` — see docker-compose.prod.yml's
# `caddy` service and DEPLOYMENT.md's "TLS / reverse proxy" section.
#
# {$APP_DOMAIN} must be a real domain name that resolves (in public DNS) to this machine, with
# ports 80 and 443 reachable from the internet — Caddy uses that to automatically obtain and renew
# a real HTTPS certificate from Let's Encrypt, with zero extra configuration. HTTP is automatically
# redirected to HTTPS.
#
# If this is a pure-internal deployment with no public DNS record for the domain (common for an
# internal-only tool kept off the public internet entirely), automatic HTTPS can't complete the
# Let's Encrypt challenge. See DEPLOYMENT.md for the manual-certificate alternative (e.g. a cert
# issued by your company's own internal CA) — it's a small, documented edit to this file.
{$APP_DOMAIN} {
	reverse_proxy app:3000 {
		# Overwrite (not append) X-Forwarded-For with exactly what Caddy itself observed as the
		# real connecting IP. Caddy's default behavior appends to any X-Forwarded-For the client
		# already sent, which would let a client prepend an arbitrary fake IP ahead of the real
		# one — and src/lib/rate-limit.ts reads the FIRST entry, so a spoofed header would still
		# get a fresh rate-limit bucket on every request despite Caddy being in front. Overwriting
		# it entirely closes that gap: whatever the client sends in this header is discarded.
		header_up X-Forwarded-For {http.request.remote.host}
	}

	encode gzip
}
