# PRODUCTION configuration template for the Django + React stack. Copy to `.env.backend` next to
# docker-compose.backend.prod.yml and fill in real values — see DEPLOYMENT.md for the full guide.
# Never commit the filled-in file; it holds real secrets. This is a separate file from
# .env.backend.uat.example so the two environments' secrets/domains can never be accidentally
# copy-pasted into each other.
#
#   cp .env.backend.production.example .env.backend
#   docker compose -f docker-compose.backend.prod.yml --env-file .env.backend up -d --build
#
# docker-compose.backend.prod.yml fails fast with a clear error at startup if any variable marked
# "Required" below is missing — there are no insecure defaults in this profile. DJANGO_DEBUG is
# hardcoded to false in that file and cannot be overridden here.

# ---- Core ----

# Required. Generate one with: openssl rand -hex 32
# A weak or missing secret lets session cookies be forged. Use a DIFFERENT value from UAT/local —
# never reuse a secret across environments.
DJANGO_SECRET_KEY=

# Required. The production domain, no scheme, no trailing slash — e.g. leave.yourcompany.com.
# Caddy (see Caddyfile.backend) uses this to request a real Let's Encrypt certificate, and Django
# uses it for ALLOWED_HOSTS.
BACKEND_APP_DOMAIN=leave.your-domain.example

# Required. Must be https://<BACKEND_APP_DOMAIN> above.
FRONTEND_URL=https://leave.your-domain.example

# ---- Database ----

# Required. Credentials for the bundled `backend-db` service. For a real production deployment,
# consider a managed Postgres provider (RDS, Cloud SQL, etc.) instead of the bundled container —
# if so, delete the `backend-db` service from docker-compose.backend.prod.yml and point
# DJANGO_DATABASE_URL (edit the `backend` service's environment block directly) at that provider's
# connection string instead of the compose-assembled one.
BACKEND_POSTGRES_USER=leaveapp_prod
BACKEND_POSTGRES_PASSWORD=
BACKEND_POSTGRES_DB=leaveapp_prod

# ---- First-admin bootstrap ----

# Leave unset/false for normal operation. Set to true only as a one-time `-e` override on the
# single `bootstrap_admin` command invocation, run once ever for this database — see
# DEPLOYMENT.md's "First HR Admin" section. Do NOT set it here as a standing value.
ALLOW_BOOTSTRAP_ADMIN=false

# ---- Rate limiting (accounts/throttles.py) ----
# Optional — defaults shown. Tighten if production sees credential-stuffing traffic.
LOGIN_RATE_LIMIT=10/min
SET_PASSWORD_RATE_LIMIT=10/min

# ---- Frontend build ----
# Optional, defaults to same-origin "/api". See the matching note in .env.backend.uat.example.
VITE_API_BASE_URL=/api

# ---- App server ----
# Optional, defaults to 1. Do NOT raise this without first pointing Django's CACHES at a shared
# backend (Redis/Memcached) — the login/set-password rate limits use Django's default in-process
# cache, which is per-worker, not shared; with more than 1 worker the effective rate limit becomes
# closer to (configured rate * workers) than the configured value — verified live during UAT
# readiness testing. Increase workers only after that's in place. See DEPLOYMENT.md.
GUNICORN_WORKERS=1

# ---- Email (invitation / password-reset) ----
#
# Example values for common providers (get real credentials from the provider's dashboard):
#   SendGrid:  SMTP_HOST=smtp.sendgrid.net       SMTP_PORT=587  SMTP_USER=apikey
#   AWS SES:   SMTP_HOST=email-smtp.<region>.amazonaws.com   SMTP_PORT=587
#   Postmark:  SMTP_HOST=smtp.postmarkapp.com    SMTP_PORT=587
#   Mailgun:   SMTP_HOST=smtp.mailgun.org        SMTP_PORT=587
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Required. Must be a sender address your provider is authorized to send as (a verified
# domain/sender in that provider's dashboard) — unverified senders are typically rejected or
# land in spam, and real employees need to actually receive their invitation.
EMAIL_FROM=Agrileaf <no-reply@your-domain.example>

# ---- Error tracking (optional, not yet wired up for this backend) ----
# Unlike the Next.js app (which reports to Sentry via SENTRY_DSN — see the root
# .env.production.example), this Django backend does not yet have Sentry integrated: no
# sentry-sdk dependency, no DSN setting. This was out of scope for the UAT-readiness hardening
# pass. If you want error tracking for this backend before a real production launch, that's a
# small, self-contained follow-up (add sentry-sdk to requirements.txt, initialize it in
# config/settings.py with a SENTRY_DSN env var) — not enabled here.
