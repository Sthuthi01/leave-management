# LOCAL DEVELOPMENT template for the Django + React stack (docker-compose.backend.yml). Copy to
# `.env` (shared with the Next.js app's own local .env — variable names don't collide) or export
# these yourself; every value below already has a working insecure-by-design default baked into
# docker-compose.backend.yml itself, so this file is optional for local dev — it exists mainly to
# document what's available to override. For UAT/production, use .env.backend.uat.example /
# .env.backend.production.example and docker-compose.backend.prod.yml instead — see DEPLOYMENT.md.

# ---- Django core ----
DJANGO_SECRET_KEY=local-dev-secret-not-for-production
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ---- Database (backend-db service, isolated from the Next.js app's own `db`) ----
BACKEND_POSTGRES_USER=leaveapp
BACKEND_POSTGRES_PASSWORD=leaveapp
BACKEND_POSTGRES_DB=leaveapp_django

# ---- CORS / CSRF / frontend origin ----
FRONTEND_URL=http://localhost:5180
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5180
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5180

# ---- Frontend build (Vite dev server reads this at container start — see frontend/Dockerfile) ----
VITE_API_BASE_URL=http://localhost:8012/api

# ---- Email — this stack's own Mailpit container (docker-compose.backend.yml), a separate
# instance from the Next.js app's own Mailpit — not shared, not required to be running ----
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Agrileaf <no-reply@agrileaf.in>

# ---- First-admin bootstrap (see accounts/management/commands/bootstrap_admin.py) ----
# Not DEBUG-gated — see DEPLOYMENT.md's "First HR Admin" section. Fine to leave true for a local
# throwaway database; still only takes effect for the single bootstrap_admin invocation.
ALLOW_BOOTSTRAP_ADMIN=true

# ---- Rate limiting (accounts/throttles.py) — optional, these are already the defaults ----
LOGIN_RATE_LIMIT=10/min
SET_PASSWORD_RATE_LIMIT=10/min
