# Copy this file to .env and fill in real values. This file is for LOCAL DEVELOPMENT
# (docker-compose.yml, which includes Mailpit for catching test emails). For a production
# deployment, use .env.production.example and docker-compose.prod.yml instead — see
# DEPLOYMENT.md for the full guide.

# Postgres connection string. When running the full stack via `docker compose up`,
# the app container is given this automatically (see docker-compose.yml) and this
# value is only used for local `npm run dev` against the same Postgres container
# (start it alone with `docker compose up db`) or your own local Postgres.
DATABASE_URL=postgres://leaflow:leaflow@localhost:5433/leaflow

# Populates demo employees/departments/leave data (src/lib/mock-data/seed.ts) on first startup
# against an empty database. docker-compose.yml already sets this to true for you. Never set
# this to true in production — mock/demo data (including a shared demo password) must never
# reach a real deployment.
SEED_DEMO_DATA=true

# Secret used to HMAC-sign the session cookie (src/lib/session.ts). Falls back to
# an insecure hardcoded default (with a startup warning) if unset — set a real
# value before deploying anywhere reachable by untrusted clients.
# Generate one with: openssl rand -hex 32
SESSION_SECRET=

# Base URL used to build the links inside invitation/password-reset emails
# (src/lib/email.ts). Falls back to http://localhost:3000 if unset.
APP_URL=http://localhost:3000

# SMTP settings used to actually send invitation/password-reset emails (src/lib/email.ts).
#
# Local development: leave these as-is (blank/defaults). docker-compose.yml runs a Mailpit
# service and points the app at it (SMTP_HOST defaults to "mailpit", port 1025, no auth) —
# every invitation/reset email will show up in the Mailpit inbox at http://localhost:8025.
# See README/instructions for how to start it.
#
# Production (or any real email provider): set these to your provider's real values —
# SendGrid, SES, Postmark, Mailgun, Gmail SMTP, etc. Setting SMTP_HOST here overrides the
# Mailpit default in docker-compose.yml, so the app will send through your real provider
# instead. If SMTP_HOST ends up unset entirely (e.g. Mailpit removed and nothing configured),
# emails are printed to the server console instead of sent.
SMTP_HOST=
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Agrileaf <no-reply@agrileaf.in>
